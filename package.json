{
  "name": "lp-template",
  "version": "1.0.0",
  "description": "LP Template with SASS",
  "scripts": {
    "sass": "sass css/styles.scss css/styles.css",
    "sass:watch": "sass --watch css/styles.scss css/styles.css",
    "serve": "browser-sync start --server --port 5000 --files 'css/*.css, *.html, img/**/*' --no-notify",
    "dev": "concurrently \"npm run sass:watch\" \"npm run serve\"",
    "build": "sass css/styles.scss css/styles.css --style compressed"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "concurrently": "^9.2.1",
    "sass": "^1.69.0"
  }
}
